cat > .gitignore << 'EOF'
# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so

# -----------------------------
# Virtual environments
# -----------------------------
venv/
.venv/
env/
ENV/

# -----------------------------
# Environment variables / API keys
# -----------------------------
.env
.env.*
.env.local

# -----------------------------
# VS Code / IDE
# -----------------------------
.vscode/
.idea/
*.swp
*.swo

# -----------------------------
# Scraped product data
# (regenerable via scraper.py)
# -----------------------------
output/
products/

# -----------------------------
# ChromaDB + embedding model
# (regenerable via embed_to_chroma.py)
# -----------------------------
chroma_db/
chroma_db/**
*.sqlite3
*.pkl

# -----------------------------
# Scraper state / resume tracking
# -----------------------------
.scraper_state.json

# -----------------------------
# Streamlit
# -----------------------------
.streamlit/

# -----------------------------
# Logs
# -----------------------------
*.log
scraper.log

# -----------------------------
# macOS / Windows
# -----------------------------
.DS_Store
Thumbs.db

# -----------------------------
# Build / Packaging
# -----------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -----------------------------
# Jupyter
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# Testing
# -----------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# -----------------------------
# Misc
# -----------------------------
.cache/
EOF